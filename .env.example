# Copy to .env and fill in strong secrets.

# Required
JWT_SECRET=change-me-to-a-long-random-string
MEILI_MASTER_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional
# Proxy / cookie settings
# TRUST_PROXY=true
# COOKIE_SECURE=auto
# COOKIE_NAME=mvbar_token
# APP_DOMAIN=mvbar.example.com
# WEB_PUSH_ENABLED=false           # true generates and retains VAPID keys in PostgreSQL
# WEB_PUSH_VAPID_PUBLIC_KEY=       # generate once with: npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_PRIVATE_KEY=      # secret; keep server-side and reuse across redeployments
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# BACKUP_MAX_UPLOAD_MB=20480     # maximum portable backup upload size
# BACKUP_DIR=/data/backups       # persistent server-managed backup storage
# PLUGINS_ENABLED=true           # disable all plugin execution without removing packages/config
# PLUGINS_DIR=/data/plugins      # persistent .ndp packages and isolated plugin storage
# PLUGIN_MAX_UPLOAD_MB=50        # maximum .ndp upload/package size
# PLUGIN_TIMEOUT_MS=15000        # hard timeout for each WebAssembly call
# PLUGIN_MEMORY_MB=64            # maximum WebAssembly memory per call
# PLUGIN_MAX_CONCURRENCY=4       # maximum simultaneous plugin workers

# Worker: library scanning
# UV_THREADPOOL_SIZE=32          # keep above SCAN_CONCURRENCY for network filesystems
# SCAN_CONCURRENCY=25            # simultaneous metadata readers
# METADATA_TIMEOUT_MS=300000     # tolerate cold or high-latency NAS files

# Worker: tempo detection
# TEMPO_DETECT=0                 # set to 1 to enable
# TEMPO_MODE=batch               # batch|scan (recommended: batch)
# TEMPO_METHOD=energy            # energy|spectral|hybrid
# TEMPO_MIN_CONF=0.35            # 0..1, higher = stricter
# TEMPO_CONCURRENCY=2            # limits ffmpeg/DSP parallelism
# TEMPO_BACKFILL_INTERVAL_MS=1800000  # batch mode: how often to run
# TEMPO_BACKFILL_BATCH=50             # batch mode: how many tracks per batch
